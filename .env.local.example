OPSRADAR_ENV=development
OPSRADAR_SECRET_KEY=dev-only-change-me
OPSRADAR_ENCRYPTION_KEY=dev-only-change-this-opsradar-encryption-key

# Local external services. Create the database with:
#   python3 scripts/init_local_db.py --database opsradar
OPSRADAR_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/opsradar
OPSRADAR_REDIS_URL=redis://127.0.0.1:6379/0
OPSRADAR_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
OPSRADAR_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

OPSRADAR_REPORT_DIR=./reports
OPSRADAR_PUBLIC_BASE_URL=http://127.0.0.1:4173
OPSRADAR_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
OPSRADAR_API_WORKERS=1
OPSRADAR_WORKER_CONCURRENCY=2
OPSRADAR_BEAT_INTERVAL_SECONDS=30

OPSRADAR_ADMIN_USERNAME=admin
OPSRADAR_ADMIN_PASSWORD=OpsRadar@123
OPSRADAR_ADMIN_DISPLAY_NAME=OpsRadar Admin
OPSRADAR_ADMIN_EMAIL=admin@opsradar.local
