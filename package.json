{
  "name": "opsradar-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api": "cd backend/opsradar-api && go run .",
    "dev:full": "npm run api & npm run dev",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --ext .ts,.vue --max-warnings=0"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.1.4",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vue-tsc": "^2.1.10"
  }
}
