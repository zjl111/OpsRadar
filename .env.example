OPSRADAR_ENV=development
OPSRADAR_HTTP_ADDR=:8080
OPSRADAR_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/opsradar?sslmode=disable
OPSRADAR_REDIS_ADDR=127.0.0.1:6379
OPSRADAR_REDIS_DB=0
OPSRADAR_DOCKER_DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/opsradar?sslmode=disable
OPSRADAR_DOCKER_REDIS_ADDR=host.docker.internal:6379
OPSRADAR_JWT_SECRET=dev-only-change-me
OPSRADAR_ENCRYPTION_KEY=dev-only-change-me
OPSRADAR_ADMIN_USERNAME=admin
OPSRADAR_ADMIN_PASSWORD=OpsRadar@123
OPSRADAR_WORKER_TOKEN=dev-worker-token
OPSRADAR_API_URL=http://127.0.0.1:8080
OPSRADAR_WORKER_NAME=worker-local-01
OPSRADAR_WORKER_REGION=local
OPSRADAR_WORKER_ZONE=dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
OPSRADAR_V1_DB=opsradar_v1
OPSRADAR_TLS_DIR=./deploy/certs
HTTP_PORT=80
HTTPS_PORT=443
